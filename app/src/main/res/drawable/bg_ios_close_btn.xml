<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- iOS 26 Liquid Glass Circular / Pill Close Button -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:angle="135"
                android:startColor="#4538527A"
                android:centerColor="#30243C5E"
                android:endColor="#2015243B"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="@color/ios_glass_btn_stroke" />
        </shape>
    </item>

    <item
        android:top="1dp"
        android:left="4dp"
        android:right="4dp"
        android:bottom="14dp">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:angle="270"
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
