<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- iOS 26 Liquid Glass Credit Card (by GiaHoai) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="135"
                android:startColor="#4500F5FF"
                android:centerColor="#25122E54"
                android:endColor="#1E0A1A30"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="#7038F9FF" />
        </shape>
    </item>

    <item
        android:top="1dp"
        android:left="4dp"
        android:right="4dp"
        android:bottom="14dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="15dp"
                android:topRightRadius="15dp"
                android:bottomLeftRadius="4dp"
                android:bottomRightRadius="4dp" />
            <gradient
                android:angle="270"
                android:startColor="#50FFFFFF"
                android:centerColor="#15FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
