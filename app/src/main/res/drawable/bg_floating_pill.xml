<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- LIQUID GLASS CAPSULE / PILL -->

    <!-- Layer 0: Vòng phát quang viền (Ambient Glow) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <stroke
                android:width="2dp"
                android:color="#4000F5FF" />
            <solid android:color="#1A00F5FF" />
        </shape>
    </item>

    <!-- Layer 1: Thân viên thuốc kính trong suốt (Translucent Liquid Body) -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:angle="135"
                android:startColor="#5515284B"
                android:centerColor="#380D1A30"
                android:endColor="#20060F1E"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="#B300F5FF" />
        </shape>
    </item>

    <!-- Layer 2: Viền phản quang trong (Inner Bevel) -->
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <stroke
                android:width="1dp"
                android:color="#66FFFFFF" />
        </shape>
    </item>

    <!-- Layer 3: Vệt sáng bóng kính trăng khuyết phía trên (Top Specular Crescent) -->
    <item
        android:top="2dp"
        android:left="6dp"
        android:right="6dp"
        android:bottom="14dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="999dp"
                android:topRightRadius="999dp"
                android:bottomLeftRadius="2dp"
                android:bottomRightRadius="2dp" />
            <gradient
                android:angle="270"
                android:startColor="#99FFFFFF"
                android:centerColor="#33FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
