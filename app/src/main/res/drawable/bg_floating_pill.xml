<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- iOS 26 Liquid Glass Capsule / Pill -->

    <!-- Layer 1: Frosted Midnight Glass Capsule Base -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:angle="135"
                android:startColor="#D9122240"
                android:centerColor="#BA0A162B"
                android:endColor="#99060D1A"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="@color/ios_glass_rim_light" />
        </shape>
    </item>

    <!-- Layer 2: Top Curved Specular Glare (Ánh kính vòm lỏng) -->
    <item
        android:top="1dp"
        android:left="6dp"
        android:right="6dp"
        android:bottom="14dp">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:angle="270"
                android:startColor="#60FFFFFF"
                android:centerColor="#18FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- Layer 3: Bottom Cyan Ambient Bounce -->
    <item
        android:top="16dp"
        android:left="8dp"
        android:right="8dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:angle="90"
                android:startColor="#3000F5FF"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
