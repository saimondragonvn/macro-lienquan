<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:angle="135"
                android:startColor="#E610213E"
                android:centerColor="#D90C172E"
                android:endColor="#C8070F1F"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="@color/glass_rim_cyan" />
            <padding
                android:bottom="6dp"
                android:left="12dp"
                android:right="12dp"
                android:top="6dp" />
        </shape>
    </item>
</layer-list>
