<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- iOS 26 Liquid Glass Inset Group Card -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="135"
                android:startColor="#381D3357"
                android:centerColor="#2612233E"
                android:endColor="#180C172B"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="@color/ios_glass_surface_stroke" />
        </shape>
    </item>

    <item
        android:top="1dp"
        android:left="4dp"
        android:right="4dp"
        android:bottom="20dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="16dp"
                android:topRightRadius="16dp"
                android:bottomLeftRadius="4dp"
                android:bottomRightRadius="4dp" />
            <gradient
                android:angle="270"
                android:startColor="#25FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
