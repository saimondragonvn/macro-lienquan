<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="135"
                android:startColor="#00F5FF"
                android:centerColor="#00D2F5"
                android:endColor="#0088FF"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#99FFFFFF" />
            <padding
                android:bottom="8dp"
                android:left="14dp"
                android:right="14dp"
                android:top="8dp" />
        </shape>
    </item>

    <item
        android:top="1dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="16dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="13dp"
                android:topRightRadius="13dp"
                android:bottomLeftRadius="2dp"
                android:bottomRightRadius="2dp" />
            <gradient
                android:angle="270"
                android:startColor="#4DFFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>

