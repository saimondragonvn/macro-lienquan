<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#E6102242"
                android:centerColor="#D909142A"
                android:endColor="#B3050C1A"
                android:type="linear" />
            <stroke
                android:width="2dp"
                android:color="@color/cyan_neon" />
            <size
                android:width="44dp"
                android:height="44dp" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>
</layer-list>
