<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Layer 1: Crystalline Sapphire Liquid Glass Base (NO STROKE / KHÔNG VIỀN) -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#651C3660"
                android:centerColor="#3D0F213E"
                android:endColor="#25060F1E"
                android:type="linear" />
            <size
                android:width="44dp"
                android:height="44dp" />
        </shape>
    </item>

    <!-- Layer 2: Subtle Cyan Chromatic Sheen -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="45"
                android:startColor="#3000E5FF"
                android:centerColor="#100099FF"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>

    <!-- Layer 3: Specular Glare (Vầng bóng kính mặt trên) -->
    <item
        android:top="2dp"
        android:left="5dp"
        android:right="5dp"
        android:bottom="19dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#70FFFFFF"
                android:centerColor="#1CFFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- Layer 4: Bottom Ambient Highlight -->
    <item
        android:top="28dp"
        android:left="8dp"
        android:right="8dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:angle="90"
                android:startColor="#25FFFFFF"
                android:centerColor="#1000E5FF"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
