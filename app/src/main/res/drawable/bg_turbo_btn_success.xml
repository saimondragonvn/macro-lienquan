<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- iOS 26 Liquid Glass Success Button -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="135"
                android:startColor="#00F59B"
                android:centerColor="#00D284"
                android:endColor="#059669"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#90FFFFFF" />
        </shape>
    </item>

    <item
        android:top="1dp"
        android:left="3dp"
        android:right="3dp"
        android:bottom="14dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="13dp"
                android:topRightRadius="13dp"
                android:bottomLeftRadius="4dp"
                android:bottomRightRadius="4dp" />
            <gradient
                android:angle="270"
                android:startColor="#60FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
