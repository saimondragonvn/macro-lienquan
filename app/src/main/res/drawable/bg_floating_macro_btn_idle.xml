<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Layer 1: Crystalline Translucent Liquid Glass Base Disc (NO STROKE / KHÔNG VIỀN) -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#60223D66"
                android:centerColor="#38101E35"
                android:endColor="#22060F1F"
                android:type="linear" />
            <size
                android:width="56dp"
                android:height="56dp" />
        </shape>
    </item>

    <!-- Layer 2: Subtle Chromatic Cyan Ambient Refraction Glow -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="45"
                android:startColor="#2600E5FF"
                android:centerColor="#0D0099FF"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>

    <!-- Layer 3: Pristine Specular Glare / Curved Glass Lens Highlight (Vầng bóng kính lỏng đỉnh) -->
    <item
        android:top="2dp"
        android:left="6dp"
        android:right="6dp"
        android:bottom="24dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#75FFFFFF"
                android:centerColor="#20FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- Layer 4: Soft Diffuse Ambient Bottom Reflection (Ánh quang đáy giọt nước) -->
    <item
        android:top="36dp"
        android:left="10dp"
        android:right="10dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:angle="90"
                android:startColor="#25FFFFFF"
                android:centerColor="#0F00E5FF"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
