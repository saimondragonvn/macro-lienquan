<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- TRUE LIQUID GLASS DROP (HIỆU ỨNG GIỌT NƯỚC / PHA LÊ LỎNG 3D) -->

    <!-- Layer 0: Vòng hào quang phát sáng nhẹ ngoài viền (Ambient Glass Glow) -->
    <item>
        <shape android:shape="oval">
            <size android:width="56dp" android:height="56dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="28dp"
                android:startColor="#3300F5FF"
                android:centerColor="#1000E5FF"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Layer 1: Lòng kính thủy tinh trong suốt quang học (Optical Clear Glass Body) -->
    <!-- Tâm kính trong suốt xuyên thấu để nhìn rõ game, rìa kính khúc xạ xanh ngọc -->
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="26dp"
                android:startColor="#1AFFFFFF"
                android:centerColor="#2600D5FF"
                android:endColor="#4D041B38" />
            <stroke
                android:width="1.8dp"
                android:color="#E600F5FF" />
        </shape>
    </item>

    <!-- Layer 2: Vành pha lê phản quang sắc nét (Crystal Refraction Ring) -->
    <item
        android:top="3dp"
        android:left="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#80FFFFFF" />
        </shape>
    </item>

    <!-- Layer 3: Đáy khúc xạ ánh sáng (Bottom Caustic Arc - Đặc trưng giọt nước lỏng) -->
    <item
        android:top="36dp"
        android:left="10dp"
        android:right="10dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <gradient
                android:angle="90"
                android:startColor="#B300F5FF"
                android:centerColor="#4DFFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- Layer 4: Vệt bóng kính trăng khuyết mặt trên (Glossy Crescent Dome) -->
    <item
        android:top="3dp"
        android:left="9dp"
        android:right="9dp"
        android:bottom="33dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#E6FFFFFF"
                android:centerColor="#66FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- Layer 5: Điểm tụ sáng giọt thủy tinh góc 11 giờ (Specular Highlight Pin) -->
    <item
        android:top="5dp"
        android:left="14dp"
        android:right="30dp"
        android:bottom="41dp">
        <shape android:shape="oval">
            <solid android:color="#F2FFFFFF" />
        </shape>
    </item>
</layer-list>
