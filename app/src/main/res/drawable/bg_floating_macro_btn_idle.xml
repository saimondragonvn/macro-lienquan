<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Premium Crystal Liquid Glass Macro Trigger (Idle State) -->

    <!-- Layer 1: Translucent Smoky Sapphire Glass Base (Trong suốt quang học cao) -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#80182E50"
                android:centerColor="#550E1C33"
                android:endColor="#3307101E"
                android:type="linear" />
            <size
                android:width="56dp"
                android:height="56dp" />
            <stroke
                android:width="1.5dp"
                android:color="#9900F5FF" />
        </shape>
    </item>

    <!-- Layer 2: Inner Optical Bevel Ring (Vành khúc xạ kép thấu kính pha lê) -->
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>

    <!-- Layer 3: Delicate Micro Top Specular Glint (Vệt bóng kính thanh mảnh đỉnh vòm, không đè icon) -->
    <item
        android:top="2dp"
        android:left="10dp"
        android:right="10dp"
        android:bottom="38dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#B3FFFFFF"
                android:centerColor="#40FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- Layer 4: Bottom Internal Caustic Bloom (Ánh quang đáy khúc xạ nội thể) -->
    <item
        android:top="42dp"
        android:left="12dp"
        android:right="12dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:angle="90"
                android:startColor="#5000F5FF"
                android:centerColor="#1A0099FF"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
