<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Game Turbo Tactical Macro Trigger (Idle State) -->

    <!-- Layer 1: Stealth Obsidian Disc with Glowing Neon Cyan Rim -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#E61A2B47"
                android:centerColor="#D90E1A30"
                android:endColor="#CC070E1C"
                android:type="linear" />
            <stroke
                android:width="2dp"
                android:color="@color/cyan_neon" />
            <size
                android:width="56dp"
                android:height="56dp" />
        </shape>
    </item>

    <!-- Layer 2: Inner Tactical Precision Ring -->
    <item
        android:top="3dp"
        android:left="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#4D00F5FF" />
        </shape>
    </item>

    <!-- Layer 3: Subtle Top Metallic Sheen -->
    <item
        android:top="2dp"
        android:left="8dp"
        android:right="8dp"
        android:bottom="30dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
