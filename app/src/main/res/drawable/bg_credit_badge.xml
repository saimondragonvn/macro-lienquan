<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="10dp" />
    <gradient
        android:angle="135"
        android:startColor="#3300F5FF"
        android:centerColor="#26122540"
        android:endColor="#1A071324"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="@color/cyan_neon" />
    <padding
        android:bottom="4dp"
        android:left="8dp"
        android:right="8dp"
        android:top="4dp" />
</shape>
