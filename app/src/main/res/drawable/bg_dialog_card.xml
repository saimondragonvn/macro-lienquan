<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="135"
                android:startColor="@color/glass_card_bg_start"
                android:centerColor="#D00F1B33"
                android:endColor="@color/glass_card_bg_end"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="@color/glass_rim_specular" />
            <padding
                android:bottom="14dp"
                android:left="14dp"
                android:right="14dp"
                android:top="14dp" />
        </shape>
    </item>
</layer-list>
