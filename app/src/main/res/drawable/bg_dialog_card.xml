<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Optimized Frosted Smoked Liquid Glass Card -->

    <!-- Layer 1: Translucent Acrylic Smoked Glass Base -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="135"
                android:startColor="#D6122240"
                android:centerColor="#C00C182E"
                android:endColor="#A6070F1F"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="#59FFFFFF" />
            <padding
                android:bottom="14dp"
                android:left="14dp"
                android:right="14dp"
                android:top="14dp" />
        </shape>
    </item>

    <!-- Layer 2: Subtle Top Specular Glass Sheen -->
    <item
        android:top="1dp"
        android:left="4dp"
        android:right="4dp"
        android:bottom="160dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="19dp"
                android:topRightRadius="19dp"
                android:bottomLeftRadius="6dp"
                android:bottomRightRadius="6dp" />
            <gradient
                android:angle="270"
                android:startColor="#25FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
