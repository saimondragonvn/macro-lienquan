<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Game Turbo HUD Control Center Card -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="135"
                android:startColor="#E60F1D36"
                android:centerColor="#D90B162B"
                android:endColor="#D0070F1E"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="@color/stroke_glass_specular" />
            <padding
                android:bottom="14dp"
                android:left="14dp"
                android:right="14dp"
                android:top="14dp" />
        </shape>
    </item>
</layer-list>
