<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Glowing Emerald Power Core with Brilliant Specular Rim -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#F000F59B"
                android:centerColor="#E608BA7B"
                android:endColor="#D9059669"
                android:type="linear" />
            <stroke
                android:width="2.5dp"
                android:color="@color/white" />
            <size
                android:width="56dp"
                android:height="56dp" />
        </shape>
    </item>
    <!-- Inner Radiant Aura Ring -->
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="oval">
            <stroke
                android:width="1.2dp"
                android:color="#80FFFFFF" />
        </shape>
    </item>
</layer-list>
