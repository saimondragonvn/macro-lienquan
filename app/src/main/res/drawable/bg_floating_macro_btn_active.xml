<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- SUPERCHARGED LIQUID EMERALD GLASS DROP (ACTIVE / FIRING STATE) -->

    <!-- Layer 0: Vòng hào quang lục bảo phát sáng mạnh (Ambient Emerald Bloom) -->
    <item>
        <shape android:shape="oval">
            <size android:width="56dp" android:height="56dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="28dp"
                android:startColor="#6600F59B"
                android:centerColor="#2600D284"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Layer 1: Thân kính ngọc lục bảo trong suốt phát quang (Luminous Emerald Glass Body) -->
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="26dp"
                android:startColor="#40FFFFFF"
                android:centerColor="#D900F59B"
                android:endColor="#E6047857" />
            <stroke
                android:width="2dp"
                android:color="#FFFFFFFF" />
        </shape>
    </item>

    <!-- Layer 2: Vành pha lê phản quang bạch kim (Platinum Refraction Ring) -->
    <item
        android:top="3dp"
        android:left="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="oval">
            <stroke
                android:width="1.2dp"
                android:color="#B3FFFFFF" />
        </shape>
    </item>

    <!-- Layer 3: Đáy khúc xạ năng lượng rực sáng (Bottom Emerald Flare) -->
    <item
        android:top="36dp"
        android:left="10dp"
        android:right="10dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <gradient
                android:angle="90"
                android:startColor="#FFFFFF"
                android:centerColor="#8000FFCC"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>

    <!-- Layer 4: Vệt bóng kính trăng khuyết đỉnh thấu kính (Brilliant Crescent Glint) -->
    <item
        android:top="3dp"
        android:left="9dp"
        android:right="9dp"
        android:bottom="33dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#FFFFFFFF"
                android:centerColor="#80FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- Layer 5: Điểm tụ sáng góc 11 giờ -->
    <item
        android:top="5dp"
        android:left="14dp"
        android:right="30dp"
        android:bottom="41dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</layer-list>
