<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Premium Crystal Liquid Glass Macro Trigger (Active / Firing State) -->

    <!-- Layer 1: Luminous Liquid Emerald Core with Brilliant Diamond Rim -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#F000F59B"
                android:centerColor="#D908BA7B"
                android:endColor="#B3059669"
                android:type="linear" />
            <size
                android:width="56dp"
                android:height="56dp" />
            <stroke
                android:width="2dp"
                android:color="#FFFFFFFF" />
        </shape>
    </item>

    <!-- Layer 2: Inner Brilliant Aura Ring -->
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <stroke
                android:width="1.2dp"
                android:color="#99FFFFFF" />
        </shape>
    </item>

    <!-- Layer 3: Delicate Micro Top Specular Glint -->
    <item
        android:top="2dp"
        android:left="10dp"
        android:right="10dp"
        android:bottom="38dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#E6FFFFFF"
                android:centerColor="#60FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- Layer 4: Bottom Radiant Emerald Bloom -->
    <item
        android:top="42dp"
        android:left="12dp"
        android:right="12dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:angle="90"
                android:startColor="#70FFFFFF"
                android:centerColor="#4000FFCC"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
