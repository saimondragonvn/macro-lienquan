<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Game Turbo Tactical Macro Trigger (Active / Firing State) -->

    <!-- Layer 1: Overcharged Glowing Emerald Power Core with White Rim -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#FF00F59B"
                android:centerColor="#E608BA7B"
                android:endColor="#D9059669"
                android:type="linear" />
            <stroke
                android:width="2.5dp"
                android:color="@color/white" />
            <size
                android:width="56dp"
                android:height="56dp" />
        </shape>
    </item>

    <!-- Layer 2: Inner Radiant Ring -->
    <item
        android:top="3dp"
        android:left="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="oval">
            <stroke
                android:width="1.2dp"
                android:color="#90FFFFFF" />
        </shape>
    </item>

    <!-- Layer 3: Blinding Flare Flare -->
    <item
        android:top="2dp"
        android:left="8dp"
        android:right="8dp"
        android:bottom="28dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#80FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
