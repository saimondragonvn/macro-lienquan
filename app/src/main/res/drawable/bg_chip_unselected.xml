<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- iOS 26 Unselected Game Profile Chip -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="135"
                android:startColor="#382C4870"
                android:centerColor="#261E3452"
                android:endColor="#18132236"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="@color/ios_glass_surface_stroke" />
            <padding
                android:bottom="7dp"
                android:left="13dp"
                android:right="13dp"
                android:top="7dp" />
        </shape>
    </item>

    <item
        android:top="1dp"
        android:left="3dp"
        android:right="3dp"
        android:bottom="14dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="13dp"
                android:topRightRadius="13dp"
                android:bottomLeftRadius="4dp"
                android:bottomRightRadius="4dp" />
            <gradient
                android:angle="270"
                android:startColor="#25FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
