<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/macroButtonRoot"
    android:layout_width="56dp"
    android:layout_height="56dp"
    android:background="@drawable/bg_floating_macro_btn_idle"
    android:elevation="16dp">

    <!-- iOS 26 Liquid Glass Optical Core Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/ivMacroBtnIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_speed"
            app:tint="@color/cyan_neon"
            android:contentDescription="Macro Icon" />

        <TextView
            android:id="@+id/tvMacroBtnLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="M1"
            android:textColor="@color/white"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:shadowColor="#E6000000"
            android:shadowDx="0"
            android:shadowDy="1.5"
            android:shadowRadius="3"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Delete Mini Badge on long press -->
    <ImageView
        android:id="@+id/ivMacroBtnDelete"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="top|end"
        android:src="@drawable/ic_close"
        android:background="@drawable/bg_turbo_btn_danger"
        android:padding="2dp"
        android:visibility="gone"
        android:contentDescription="Delete Macro Button" />

</FrameLayout>
