<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/macroButtonRoot"
    android:layout_width="56dp"
    android:layout_height="56dp"
    android:background="@drawable/bg_floating_macro_btn_idle"
    android:elevation="14dp">

    <!-- Glowing Circular Border / Status indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="4dp">

        <ImageView
            android:id="@+id/ivMacroBtnIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_speed"
            android:contentDescription="Macro Icon" />

        <TextView
            android:id="@+id/tvMacroBtnLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="M1"
            android:textColor="@color/text_primary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Close / Delete Mini Badge on long press -->
    <ImageView
        android:id="@+id/ivMacroBtnDelete"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="top|end"
        android:src="@drawable/ic_close"
        android:visibility="gone"
        android:contentDescription="Delete Macro Button" />

</FrameLayout>
