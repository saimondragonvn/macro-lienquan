<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Gaming Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_floating_pill"
                    android:padding="10dp"
                    android:src="@drawable/ic_macro_tile"
                    app:tint="@color/cyan_neon"
                    android:contentDescription="Logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GAME TURBO PRO"
                        android:textColor="@color/cyan_neon"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04" />

                    <TextView
                        android:id="@+id/tvDeviceBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Thiết bị: Infinix Note 30 • 120Hz Fast Combo"
                        android:textColor="@color/emerald_play"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvGlobalStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_floating_pill"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="SẴN SÀNG"
                    android:textColor="@color/emerald_play"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Nút Bật/Tắt Game Turbo To và Nổi Bật Nhất -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleTurbo"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/cyan_neon"
                app:cornerRadius="14dp"
                android:text="⚡ BẬT GAME TURBO HUD"
                android:textColor="@color/bg_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <!-- Card 1: Quyền Cửa Sổ Nổi (Overlay Window) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/bg_surface"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/stroke_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_macro_tile"
                            app:tint="@color/cyan_neon"
                            android:contentDescription="Overlay Icon" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="1. CỬA SỔ NỔI TRÊN GAME"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvOverlayBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CHƯA CẤP"
                            android:textColor="@color/amber_warning"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Hiển thị thanh công cụ Game Turbo mép màn hình khi chơi game Liên Quân."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGrantOverlay"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:backgroundTint="@color/bg_surface_elevated"
                        app:strokeColor="@color/cyan_neon"
                        app:strokeWidth="1dp"
                        android:text="Cấp quyền Hiển thị trên ứng dụng khác"
                        android:textColor="@color/cyan_neon"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Động cơ Game Turbo (Shizuku & Root) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/bg_surface"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/purple_accent"
                app:strokeWidth="1.2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_speed"
                            app:tint="@color/purple_accent"
                            android:contentDescription="Turbo Icon" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="2. ĐỘNG CƠ SHIZUKU / ROOT"
                            android:textColor="@color/purple_accent"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvShizukuBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CHƯA CẤP"
                            android:textColor="@color/amber_warning"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Tự động click combo chiêu siêu tốc 120Hz không cần Trợ năng. Kích hoạt qua Shizuku (Gỡ lỗi Wi-Fi) hoặc Root trên giả lập."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGrantShizuku"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:backgroundTint="@color/purple_accent"
                            android:text="⚡ Cấp quyền Shizuku"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopyAdb"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="0.9"
                            android:backgroundTint="@color/bg_surface_elevated"
                            app:strokeColor="@color/purple_accent"
                            app:strokeWidth="1dp"
                            android:text="📋 Sao chép ADB"
                            android:textColor="@color/purple_accent"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Mở khóa trên Infinix Note 30 (Transsion XOS) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/bg_surface_elevated"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/stroke_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📌 DÀNH CHO INFINIX NOTE 30 (XOS 13/14)"
                        android:textColor="@color/cyan_neon"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Nếu ứng dụng bị hệ thống XOS giới hạn quyền: Bấm nút dưới $\\rightarrow$ Bấm nút 3 chấm (⋮) ở góc trên bên phải màn hình $\\rightarrow$ Chọn 'Cho phép cài đặt bị hạn chế'."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUnlockInfinix"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="@color/bg_surface"
                        app:strokeColor="@color/cyan_neon"
                        app:strokeWidth="1dp"
                        android:text="🔓 Mở trang Cài đặt ứng dụng Infinix"
                        android:textColor="@color/cyan_neon"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Hướng dẫn sử dụng trong game (Game Turbo Guide) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bg_surface"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/stroke_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎮 HƯỚNG DẪN 3 BƯỚC DÙNG TRONG GAME"
                        android:textColor="@color/emerald_play"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="1️⃣ Bấm 'BẬT GAME TURBO HUD' ở trên rồi vào game Liên Quân Mobile.\n\n2️⃣ Chạm vào tab nhỏ [⚡ TURBO] ở mép màn hình để mở bảng điều khiển.\n\n3️⃣ Bấm [+ Ghim Điểm] để kéo các điểm (1, 2, 3...) vào nút chiêu, sau đó bấm [🚀 TẠO NÚT BẤM TURBO] là có ngay nút tròn trên màn hình. Chạm nút tròn để xả combo!"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
