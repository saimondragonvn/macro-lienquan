<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dockRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000"
    android:clickable="true"
    android:focusable="true">

    <!-- 1. Trạng thái THU GỌN (Game Turbo Edge Tab) -->
    <LinearLayout
        android:id="@+id/layoutCollapsed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_floating_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:elevation="16dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivCollapsedHandle"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_macro_tile"
            android:contentDescription="Drag Handle" />

        <TextView
            android:id="@+id/tvCollapsedTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="⚡ TURBO • GIAHOAI"
            android:textColor="@color/cyan_neon"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />
    </LinearLayout>

    <!-- 2. Trạng thái MỞ RỘNG (Game Turbo HUD Control Center) -->
    <LinearLayout
        android:id="@+id/layoutExpanded"
        android:layout_width="310dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_dialog_card"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="14dp"
        android:elevation="20dp"
        android:visibility="gone">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/layoutExpandedHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_floating_pill">

                <ImageView
                    android:id="@+id/ivExpandedDrag"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_macro_tile"
                    android:contentDescription="Drag Panel" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GAME TURBO PRO"
                        android:textColor="@color/cyan_neon"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04" />

                    <!-- CRE GIAHOAI HEADER BADGE -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_credit_badge"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:paddingTop="1dp"
                        android:paddingBottom="1dp"
                        android:text="Cre: GiaHoai"
                        android:textColor="@color/cyan_neon"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvEngineStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢 Shizuku: SẴN SÀNG"
                    android:textColor="@color/emerald_play"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnCollapseDock"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_turbo_btn_secondary"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="✕ Đóng"
                android:clickable="true"
                android:focusable="true"
                android:textColor="@color/amber_warning"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/stroke_border"
            android:layout_marginBottom="8dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- KHỐI QUẢN LÝ HỒ SƠ GAME (MULTI-GAME PROFILE MANAGER) -->
                <LinearLayout
                    android:id="@+id/layoutGameProfileHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_turbo_btn_secondary"
                    android:padding="8dp"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvActiveProfileBadge"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🎮 HỒ SƠ GAME ĐANG CHỌN:"
                            android:textColor="@color/cyan_neon"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.03" />

                        <TextView
                            android:id="@+id/btnAddNewGameProfile"
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_turbo_btn_primary"
                            android:gravity="center"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="+ Thêm Game"
                            android:textColor="@color/bg_dark"
                            android:textSize="9.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Thanh cuộn ngang các Game Profile (Chips) -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/layoutProfileChipsContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <!-- Tóm tắt hồ sơ hiện tại & Sửa/Xóa -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvActiveProfileSummary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Liên Quân Mobile (0 nút)"
                            android:textColor="@color/emerald_play"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnRenameCurrentProfile"
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:background="@drawable/bg_turbo_btn_secondary"
                            android:gravity="center"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:text="✏️ Sửa tên"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp" />

                        <TextView
                            android:id="@+id/btnDeleteCurrentProfile"
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_turbo_btn_secondary"
                            android:gravity="center"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:text="🗑️ Xóa"
                            android:textColor="@color/crimson_stop"
                            android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Nút Mở Game Nhanh -->
                <TextView
                    android:id="@+id/btnLaunchGameFromDock"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_turbo_btn_primary"
                    android:gravity="center"
                    android:text="🚀 MỞ LIÊN QUÂN MOBILE"
                    android:textColor="@color/bg_dark"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"
                    android:layout_marginBottom="8dp" />

                <!-- NÚT GHI COMBO THỰC TẾ (REDMI STYLE) -->
                <TextView
                    android:id="@+id/btnStartKernelRecord"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_turbo_btn_danger"
                    android:gravity="center"
                    android:text="🔴 BẮT ĐẦU GHI COMBO (VÀO GAME)"
                    android:textColor="@color/white"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03"
                    android:layout_marginBottom="8dp" />

                <!-- NÚT DI CHUYỂN & SỬA VỊ TRÍ NÚT COMBO -->
                <TextView
                    android:id="@+id/btnEditTriggerPositions"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_turbo_btn_secondary"
                    android:gravity="center"
                    android:text="🎯 DI CHUYỂN &amp; SỬA VỊ TRÍ NÚT"
                    android:textColor="@color/cyan_neon"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"
                    android:layout_marginBottom="10dp" />

                <!-- GHIM ĐIỂM THỦ CÔNG (TARGET PINS) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnAddPoint"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.2"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_turbo_btn_secondary"
                        android:gravity="center"
                        android:text="+ Ghim Điểm"
                        android:textColor="@color/cyan_neon"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnRemovePoint"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.8"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_turbo_btn_secondary"
                        android:gravity="center"
                        android:text="- Bớt"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/btnPlayTest"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.0"
                        android:background="@drawable/bg_turbo_btn_secondary"
                        android:gravity="center"
                        android:text="▶ Thử Click"
                        android:textColor="@color/emerald_play"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Nút Tạo Nút Macro từ điểm ghim -->
                <TextView
                    android:id="@+id/btnCreateMacroBtn"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_turbo_btn_primary"
                    android:gravity="center"
                    android:text="⚡ TẠO NÚT BẤM TỪ ĐIỂM GHIM"
                    android:textColor="@color/bg_dark"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Tốc độ delay -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⏱️ Tốc độ:"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/btnSpeedFast"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/bg_turbo_btn_primary"
                        android:gravity="center"
                        android:text="30ms"
                        android:textColor="@color/bg_dark"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnSpeedNormal"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/bg_turbo_btn_secondary"
                        android:gravity="center"
                        android:text="60ms"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/btnSpeedSlow"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_turbo_btn_secondary"
                        android:gravity="center"
                        android:text="120ms"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke_border"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp" />

                <!-- ĐỘ MỜ NÚT (ẨN MỜ / TRONG SUỐT) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👻 ĐỘ MỜ NÚT TRÊN MÀN HÌNH (ẨN MỜ):"
                    android:textColor="@color/cyan_neon"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnGlobalOpacity30"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/bg_turbo_btn_secondary"
                        android:gravity="center"
                        android:text="30% Mờ"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/btnGlobalOpacity50"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/bg_turbo_btn_secondary"
                        android:gravity="center"
                        android:text="50% Vừa"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/btnGlobalOpacity80"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/bg_turbo_btn_primary"
                        android:gravity="center"
                        android:text="80% Rõ"
                        android:textColor="@color/bg_dark"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnGlobalOpacity100"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_turbo_btn_secondary"
                        android:gravity="center"
                        android:text="100% Đậm"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke_border"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp" />

                <!-- DANH SÁCH NÚT MACRO ĐÃ TẠO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📋 NÚT COMBO ĐÃ TẠO:"
                        android:textColor="@color/cyan_neon"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnRefreshTriggers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔄 Tải lại"
                        android:textColor="@color/text_secondary"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNoTriggers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:text="Chưa có nút nào. Bấm [🔴 Ghi Combo] để tạo."
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:visibility="visible" />

                <LinearLayout
                    android:id="@+id/layoutAssignedTriggers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/btnClearAllTriggers"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_turbo_btn_secondary"
                    android:gravity="center"
                    android:text="🗑️ XÓA TOÀN BỘ NÚT COMBO"
                    android:textColor="@color/crimson_stop"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke_border"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp" />

                <!-- CÔNG CỤ TIỆN ÍCH -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnToggleVisibility"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_turbo_btn_secondary"
                        android:gravity="center"
                        android:text="👁️ Ẩn/Hiện"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/btnClearPoints"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_turbo_btn_secondary"
                        android:gravity="center"
                        android:text="🗑️ Xóa Ghim"
                        android:textColor="@color/amber_warning"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/btnCloseService"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_turbo_btn_secondary"
                        android:gravity="center"
                        android:text="✕ Tắt Turbo"
                        android:textColor="@color/crimson_stop"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnBottomCollapse"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_turbo_btn_secondary"
                    android:gravity="center"
                    android:text="✕ ĐÓNG MENU TURBO"
                    android:textColor="@color/amber_warning"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <!-- CRE GIAHOAI DEDICATED GAMING HUD FOOTER -->
                <LinearLayout
                    android:id="@+id/layoutCreGiaHoai"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/bg_credit_badge"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="GAME TURBO PRO • CRE: GIAHOAI"
                        android:textColor="@color/cyan_neon"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

</FrameLayout>
