<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp"
    android:elevation="20dp">

    <!-- Chấm đỏ ghi hình nhấp nháy -->
    <TextView
        android:id="@+id/tvRecordingDot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔴"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GHI COMBO"
                android:textColor="@color/crimson_stop"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_ios_credit_card"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:text="GiaHoai"
                android:textColor="@color/cre_giahoai_accent"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRecordingTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="00:00"
                android:textColor="@color/white"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRecordingActionCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chạm vào game thoải mái (0 thao tác)"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Nút Hoàn Tất & Lưu Combo -->
    <TextView
        android:id="@+id/btnStopRecordingPill"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginStart="14dp"
        android:background="@drawable/bg_turbo_btn_primary"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="⏹ XONG &amp; LƯU"
        android:textColor="@color/bg_dark"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:letterSpacing="0.02" />

    <!-- Nút Hủy Ghi -->
    <TextView
        android:id="@+id/btnCancelRecordingPill"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_turbo_btn_secondary"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="✕ HỦY"
        android:textColor="@color/amber_warning"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
