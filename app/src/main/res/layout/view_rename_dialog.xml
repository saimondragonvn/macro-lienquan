<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/renameDialogRoot"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:padding="16dp"
    android:elevation="24dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✏️ ĐỔI TÊN NÚT COMBO"
        android:textColor="@color/cyan_neon"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.04"
        android:layout_marginBottom="10dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/stroke_border"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nhập tên mới (hiển thị trên nút nổi):"
        android:textColor="@color/text_secondary"
        android:textSize="10.5sp" />

    <EditText
        android:id="@+id/etRenameInput"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_turbo_btn_secondary"
        android:hint="Tên combo (VD: Florentino, Raz)"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/cyan_neon"
        android:textSize="13sp"
        android:textStyle="bold"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:maxLength="15"
        android:inputType="text" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnRenameCancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_turbo_btn_secondary"
            android:gravity="center"
            android:text="✕ HỦY"
            android:textColor="@color/amber_warning"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnRenameConfirm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:background="@drawable/bg_turbo_btn_primary"
            android:gravity="center"
            android:text="💾 LƯU TÊN"
            android:textColor="@color/bg_dark"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
