<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/createProfileDialogRoot"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:padding="16dp"
    android:elevation="24dp">

    <!-- iOS Dynamic Island Style Grabber -->
    <View
        android:layout_width="36dp"
        android:layout_height="4.5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_ios_grabber" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_floating_pill">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🎮"
                android:textSize="18sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THÊM HỒ SƠ GAME"
                android:textColor="@color/cyan_neon"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lưu cấu hình macro riêng cho game mới"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/stroke_border"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✏️ Nhập tên game:"
        android:textColor="@color/text_primary"
        android:textSize="11.5sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etCreateProfileName"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_turbo_btn_secondary"
        android:hint="VD: Free Fire, Tốc Chiến, Genshin..."
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/cyan_neon"
        android:textSize="13sp"
        android:textStyle="bold"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:maxLength="20"
        android:inputType="text" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCreateProfileCancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_turbo_btn_secondary"
            android:gravity="center"
            android:text="✕ HỦY"
            android:textColor="@color/amber_warning"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCreateProfileConfirm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:background="@drawable/bg_turbo_btn_primary"
            android:gravity="center"
            android:text="💾 TẠO &amp; CHỌN"
            android:textColor="@color/bg_dark"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />
    </LinearLayout>

    <!-- Cre GiaHoai Badge -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:text="✨ iOS 26 Liquid Glass • Cre: GiaHoai"
        android:textColor="@color/cre_giahoai_accent"
        android:textSize="9.5sp"
        android:textStyle="bold"
        android:letterSpacing="0.04" />

</LinearLayout>
