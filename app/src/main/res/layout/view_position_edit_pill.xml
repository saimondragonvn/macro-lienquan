<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp"
    android:elevation="18dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎯"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHỈNH SỬA VỊ TRÍ NÚT"
            android:textColor="@color/cyan_neon"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.03" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kéo nút tới mọi vị trí mong muốn rồi bấm Lưu"
            android:textColor="@color/text_secondary"
            android:textSize="9.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnSaveAndLockPositions"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:background="@drawable/bg_turbo_btn_primary"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="💾 LƯU &amp; KHÓA VỊ TRÍ"
        android:textColor="@color/bg_dark"
        android:textSize="10.5sp"
        android:textStyle="bold" />

</LinearLayout>
