<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/saveComboDialogRoot"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:padding="16dp"
    android:elevation="24dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_macro_tile"
            android:contentDescription="Turbo Icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LƯU COMBO MỚI"
                android:textColor="@color/cyan_neon"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/tvSaveComboSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã ghi nhận 4 thao tác chuẩn xác"
                android:textColor="@color/emerald_play"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/stroke_border"
        android:layout_marginBottom="12dp" />

    <!-- Tên Combo -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✏️ Tên nút Combo:"
        android:textColor="@color/text_primary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etSaveComboName"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_turbo_btn_secondary"
        android:hint="VD: Florentino, Mua đồ, Raz"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/cyan_neon"
        android:textSize="13sp"
        android:textStyle="bold"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:maxLength="15"
        android:inputType="text" />

    <!-- Tùy chọn Tốc độ Replay -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="⚡ Tốc độ xả combo:"
        android:textColor="@color/text_primary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnSaveSpeed10"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_turbo_btn_primary"
            android:gravity="center"
            android:text="1.0x (Chuẩn)"
            android:textColor="@color/bg_dark"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSaveSpeed15"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_turbo_btn_secondary"
            android:gravity="center"
            android:text="1.5x (Nhanh)"
            android:textColor="@color/text_primary"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSaveSpeed20"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_turbo_btn_secondary"
            android:gravity="center"
            android:text="2.0x (Siêu Tốc)"
            android:textColor="@color/text_primary"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/stroke_border"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnSaveComboCancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_turbo_btn_secondary"
            android:gravity="center"
            android:text="✕ HỦY"
            android:textColor="@color/amber_warning"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSaveComboConfirm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:background="@drawable/bg_turbo_btn_primary"
            android:gravity="center"
            android:text="💾 LƯU &amp; TẠO NÚT"
            android:textColor="@color/bg_dark"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
