<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_turbo_btn_secondary"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <TextView
        android:id="@+id/tvTriggerBadge"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_floating_macro_btn_idle"
        android:gravity="center"
        android:text="C1"
        android:textColor="@color/cyan_neon"
        android:textSize="10.5sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTriggerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nút Combo C1"
            android:textColor="@color/text_primary"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTriggerSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3 điểm • 30ms • 80%"
            android:textColor="@color/text_secondary"
            android:textSize="9.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnTriggerRename"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_turbo_btn_secondary"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="✏️ Sửa"
        android:textColor="@color/cyan_neon"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnTriggerToggle"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_turbo_btn_secondary"
        android:gravity="center"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:text="👁️"
        android:textColor="@color/text_primary"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/btnTriggerRestorePins"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_turbo_btn_secondary"
        android:gravity="center"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:text="🎯"
        android:textColor="@color/cyan_neon"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/btnTriggerDelete"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:background="@drawable/bg_turbo_btn_danger"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="✕"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
