<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/recorderRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rec_overlay_tint">

    <!-- Interactive Touch Canvas where touches are drawn -->
    <com.macrophone.gaming.ui.overlay.TouchRecorderCanvas
        android:id="@+id/touchCanvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Floating Control Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_margin="16dp"
        android:background="@drawable/bg_dialog_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_record"
            android:contentDescription="Recording indicator" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ĐANG GHI THAO TÁC..."
                android:textColor="@color/crimson_stop"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPointCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã ghi: 0 thao tác"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelRecord"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/bg_surface_elevated"
            android:text="@string/rec_btn_cancel"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveRecord"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="@color/emerald_play"
            android:text="@string/rec_btn_save"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Instruction Guide -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_floating_pill"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/rec_instructions"
        android:textColor="@color/text_primary"
        android:textSize="12sp" />

</RelativeLayout>
