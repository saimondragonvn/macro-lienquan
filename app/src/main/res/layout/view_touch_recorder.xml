<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/recorderRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A000000">

    <!-- Interactive Touch Canvas where touches are drawn -->
    <com.macrophone.gaming.ui.overlay.TouchRecorderCanvas
        android:id="@+id/touchCanvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Floating Control Bar (Game Turbo Live Recording Bar) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_dialog_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:elevation="18dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_record"
            android:contentDescription="Recording indicator" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ĐANG GHI THAO TÁC..."
                android:textColor="@color/crimson_stop"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPointCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã ghi: 0 thao tác"
                android:textColor="@color/cyan_neon"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Nút Hoàn tác / Xóa thao tác vừa ghi -->
        <TextView
            android:id="@+id/btnUndoRecord"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_turbo_btn_secondary"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="↩ Xóa"
            android:textColor="@color/amber_warning"
            android:textSize="11sp" />

        <!-- Nút Hủy bỏ -->
        <TextView
            android:id="@+id/btnCancelRecord"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_turbo_btn_secondary"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="✕ Hủy"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />

        <!-- Nút DỪNG GHI (STOP) To, rõ ràng, màu đỏ rực rỡ -->
        <TextView
            android:id="@+id/btnStopRecord"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_turbo_btn_danger"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="⏹️ DỪNG GHI (STOP)"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Instruction Guide -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_floating_pill"
        android:clickable="false"
        android:focusable="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="👉 Chạm hoặc vuốt trên màn hình để ghi combo. Bấm [⏹️ DỪNG GHI] khi hoàn thành!"
        android:textColor="@color/text_primary"
        android:textSize="11sp" />

</RelativeLayout>
